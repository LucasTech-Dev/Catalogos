# Decisão vigente: demonstração sobre banco persistente existente. Não aplicar sem aprovação.
APP_ENV=homologacao
NODE_ENV=production
GCLOUD_PROJECT=bancorestaurante
FIREBASE_EXPECTED_PROJECT_ID=bancorestaurante
FIREBASE_HOMOLOG_PROJECT_ID=bancorestaurante
FIREBASE_EXISTING_DEMO_PROJECT_ID=bancorestaurante
FIREBASE_CREDENTIAL_MODE=render-secret-file
# Identidade sugerida, NÃO criada/verificada; confirmar email exato antes do uso.
FIREBASE_SERVICE_ACCOUNT_EMAIL=catalogos-api-demo-readonly@bancorestaurante.iam.gserviceaccount.com
CORS_ORIGINS=https://catalogo-demo-cz1.pages.dev
RATE_LIMIT_MODE=enforce
HTTP_LOG_ENABLED=1
# PORT injetada pelo Render. Não definir GOOGLE_APPLICATION_CREDENTIALS/Emulator.
# Secret File: /etc/secrets/firebase-homologacao.json; conteúdo nunca no Git/VITE_*.

# Primeira publicação: somente leitura. Nunca omitir o modo ao configurar o Render.
CATALOGOS_RUNTIME_MODE=public-readonly-demo
CATALOGOS_DEMO_LOJA_ID=loja-demo
# Sem revisão dos registros reais: catálogo retorna 503 sem consultar o banco.
CATALOGOS_DEMO_CATALOG_APPROVED=0
CATALOGOS_DEMO_PRODUCT_IDS=[]
CATALOGOS_DEMO_CATEGORY_IDS=[]
# Só mudar aprovação para 1 após revisão humana e listas explícitas de IDs.
