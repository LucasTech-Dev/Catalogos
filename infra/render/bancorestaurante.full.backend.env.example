# MVP-02-H1: destino único é o serviço existente catalogos-api-homolog.
# Preparação local; substituir fixtures somente após gates, rollback e deploy autorizado.
# Requer gates IAM/Rules/índices/ingresso/dados e publicação explicitamente autorizada.
APP_ENV=homologacao
NODE_ENV=production
CATALOGOS_RUNTIME_MODE=full
# MVP-02: nenhuma loja aprovada para leitura pública de dados reais. Liberar só na MVP-03.
CATALOGOS_PUBLIC_CATALOG_LOJAS=[]
GCLOUD_PROJECT=bancorestaurante
FIREBASE_EXPECTED_PROJECT_ID=bancorestaurante
FIREBASE_HOMOLOG_PROJECT_ID=bancorestaurante
FIREBASE_EXISTING_DEMO_PROJECT_ID=bancorestaurante
FIREBASE_CREDENTIAL_MODE=render-secret-file
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/firebase-homologacao.json
# Identidade real criada manualmente em18/10/2026; verificada habilitada.
# Este modelo local não concede IAM nem autoriza chave/upload/deploy.
FIREBASE_SERVICE_ACCOUNT_EMAIL=cat-logos-api-full-homologa-o@bancorestaurante.iam.gserviceaccount.com
CORS_ORIGINS=https://catalogo-demo-cz1.pages.dev
RATE_LIMIT_MODE=enforce
HTTP_LOG_ENABLED=1
# PORT: fornecida pelo Render; servidor escuta 0.0.0.0.
# Secret File futuro: firebase-homologacao.json, /etc/secrets/firebase-homologacao.json.
# Não incluir JSON/chave neste modelo, no Git, no build ou em VITE_*.
# GOOGLE_APPLICATION_CREDENTIALS aceita somente o caminho fixo acima neste modo.
# O loader valida a identidade via cert(); não usa ADC pessoal ou fallback de credencial.
# Não definir hosts Emulator ou CATALOGOS_DEMO_*.
# full NÃO restringe servidor a loja-demo: loja vem da rota e é autorizada no backend.
# Frontend permanece em vitrine até etapas posteriores e autorização específica.
