# Render Node/Free: modo isolado, sem Firebase, ADC ou Secret File.
APP_ENV=homologacao
NODE_ENV=production
CATALOGOS_RUNTIME_MODE=public-fixture-demo
CATALOGOS_DEMO_LOJA_ID=loja-demo
CORS_ORIGINS=https://catalogo-demo-cz1.pages.dev
RATE_LIMIT_MODE=enforce
HTTP_LOG_ENABLED=1
# PORT fornecida pelo Render. Para preview, acrescentar a origem EXATA aprovada em CORS_ORIGINS, separada por vírgula.
