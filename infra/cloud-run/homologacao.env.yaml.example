# Modelo NÃO implantável sem substituir os valores e obter aprovação.
# Usar projeto dedicado de homologação; nunca copiar ADC ou chave JSON.
APP_ENV: homologacao
NODE_ENV: production
GCLOUD_PROJECT: SUBSTITUIR_PROJETO_HOMOLOGACAO
FIREBASE_EXPECTED_PROJECT_ID: SUBSTITUIR_PROJETO_HOMOLOGACAO
CORS_ORIGINS: https://homolog.example.com
RATE_LIMIT_MODE: enforce
HTTP_LOG_ENABLED: "1"
# PORT é fornecida pelo Cloud Run (--port=8080).
# Não definir GOOGLE_APPLICATION_CREDENTIALS ou variáveis de Emulator.
