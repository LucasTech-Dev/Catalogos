# Alternativa futura de identidade gerenciada (por exemplo, Cloud Run), não Render Free.
APP_ENV=homologacao
NODE_ENV=production
GCLOUD_PROJECT=catalogos-homolog-exemplo
PORT=8080
FIREBASE_EXPECTED_PROJECT_ID=catalogos-homolog-exemplo
FIREBASE_HOMOLOG_PROJECT_ID=catalogos-homolog-exemplo
FIREBASE_CREDENTIAL_MODE=managed
CORS_ORIGINS=https://homolog.example.com,https://b.example.com
RATE_LIMIT_MODE=enforce
HTTP_LOG_ENABLED=1
# Render: usar infra/render/homologacao.backend.env.example.
