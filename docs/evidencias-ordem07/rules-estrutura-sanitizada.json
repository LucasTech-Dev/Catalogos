[
  {
    "declaracoes": [
      "match /databases/{database}/documents {",
      "match /lojas/loja-demo {",
      "allow create, update: if",
      "allow read: if true;",
      "match /lojas/loja-demo/ADM/{admId} {",
      "allow create, update: if",
      "allow read: if true;",
      "match /lojas/loja-demo/categorias/{categoriaId} {",
      "allow create, update: if",
      "allow read: if true;",
      "match /lojas/loja-demo/produtos/{produtoId} {",
      "allow create, update: if",
      "allow read: if true;",
      "match /lojas/loja-demo/clientes/{clienteId} {",
      "allow create, update: if",
      "allow read: if true;",
      "match /lojas/loja-demo/clientes/{clienteId}/enderecos/{enderecoId} {",
      "allow create, update: if",
      "allow read: if true;",
      "match /lojas/loja-demo/pedidos/{pedidoId} {",
      "allow create, update: if",
      "allow read: if true;"
    ],
    "allow": [
      {
        "metodos": "create,update",
        "condicao": "request.resource.data.nome is string"
      },
      {
        "metodos": "read",
        "condicao": "true"
      },
      {
        "metodos": "create,update",
        "condicao": "request.resource.data.nome is string && request.resource.data.lojaId == '[literal omitido]'"
      },
      {
        "metodos": "read",
        "condicao": "true"
      },
      {
        "metodos": "create,update",
        "condicao": "request.resource.data.nome is string && request.resource.data.slug is string"
      },
      {
        "metodos": "read",
        "condicao": "true"
      },
      {
        "metodos": "create,update",
        "condicao": "request.resource.data.nome is string && request.resource.data.preco is number && request.resource.data.categoriaId is string && request.resource.data.lojaId == '[literal omitido]'"
      },
      {
        "metodos": "read",
        "condicao": "true"
      },
      {
        "metodos": "create,update",
        "condicao": "request.resource.data.nome is string && request.resource.data.lojaId == '[literal omitido]'"
      },
      {
        "metodos": "read",
        "condicao": "true"
      },
      {
        "metodos": "create,update",
        "condicao": "request.resource.data.apelido is string"
      },
      {
        "metodos": "read",
        "condicao": "true"
      },
      {
        "metodos": "create,update",
        "condicao": "request.resource.data.lojaId == '[literal omitido]' && request.resource.data.numero is string && request.resource.data.status is string && request.resource.data.total is number"
      },
      {
        "metodos": "read",
        "condicao": "true"
      }
    ]
  }
]
