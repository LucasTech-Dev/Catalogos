rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A Etapa 19 acessa dados somente pela API autorizada/Admin SDK.
    match /{document=**} { allow read, write: if false; }
  }
}
// A negação inclui usuarios, lojas, produtos, categorias, clientes,
// enderecos, pedidos, idempotencia e qualquer coleção desconhecida.
// Catálogo público é projeção da API. Admin SDK exige autorização no backend.
