PORT=3000
APP_ENV=development
# NODE_ENV=production exige APP_ENV=homologacao ou production e configuração externa completa.
# Exemplos fictícios completos: infra/ambientes/*.backend.env.example.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Credencial Admin permanece fora do repositório e do frontend.
# GOOGLE_APPLICATION_CREDENTIALS=/caminho/externo/conta-de-servico.json
# Emulação: ambos os hosts locais e GCLOUD_PROJECT demo- são obrigatórios juntos.
# GCLOUD_PROJECT=demo-catalogos-emulator
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Render homologação: infra/render/homologacao.backend.env.example
# FIREBASE_CREDENTIAL_MODE=render-secret-file
# FIREBASE_HOMOLOG_PROJECT_ID=catalogos-homolog-2026
# FIREBASE_SERVICE_ACCOUNT_EMAIL=catalogos-api-homolog@catalogos-homolog-2026.iam.gserviceaccount.com
