VITE_APP_ENV=development
# Build externo: npm run build:externo; exemplos em infra/ambientes/*.web.env.example.
# VITE_LOJAS_POR_HOST={"a.example.com":"loja-a","b.example.com":"loja-b"}
VITE_LOJA_ID=loja-demo
# Configuração pública Firebase Web. Nunca usar conta de serviço/Admin SDK aqui.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Somente testes locais com projeto demo-:
# VITE_FIREBASE_PROJECT_ID=demo-catalogos-emulator
# VITE_FIREBASE_API_KEY=fake-api-key
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# A inicialização rejeita URL remota de emulador ou mistura com projeto real.
VITE_CATALOGOS_RUNTIME_MODE=full
# Runtime full usa Web SDK; VITE_API_URL é exclusivo dos modos históricos de fixtures.
